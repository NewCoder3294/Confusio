# Copy to .env and fill in. .env is gitignored.

# Foundry tenant — confirmed.
FOUNDRY_HOST=https://nicolasdossantos.usw-18.palantirfoundry.com

# Service-user token. In Foundry: Account → Settings → Tokens → New token (service user).
# Treat like a secret. Do not paste anywhere else.
FOUNDRY_TOKEN=

# Ontology rid. Find it once the Ontology is created in Foundry —
# format looks like ri.ontology.main.ontology.<uuid>. The bridge will refuse
# to start without it.
FOUNDRY_ONTOLOGY_RID=
